rules_version = '2';
service cloud.firestore { match /databases/{database}/documents {
  function signedIn(){return request.auth != null;}
  function editor(){return signedIn() && (request.auth.token.role == 'editor' || request.auth.token.role == 'admin');}
  match /events/{id}{allow read: if resource.data.status in ['published','cancelled','sold_out']; allow write: if editor();}
  match /venues/{id}{allow read: if true; allow write: if editor();}
  match /editorialLists/{id}{allow read: if resource.data.status == 'published'; allow write: if editor();}
  match /users/{uid}{allow read,create,update: if signedIn() && request.auth.uid == uid; allow delete: if false; match /savedEvents/{id}{allow read,create,delete: if signedIn() && request.auth.uid == uid; allow update: if false;}}
  match /{path=**}{allow read,write: if false;}
} }
